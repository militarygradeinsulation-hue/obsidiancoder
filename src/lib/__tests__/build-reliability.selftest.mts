import assert from "node:assert/strict";
import { assertRefineDesign, requestsRedesign } from "../refine-design.ts";
import { normalizeDomain, domainRecords, PAGES_IPV4 } from "../owned-domain.ts";
import { assetContext, restoreProjectImages } from "../project-assets.ts";
const before = '<html><head><style>body { color: red; }</style></head><body><header>Brand</header><main>Before</main></body></html>';
assert.doesNotThrow(() => assertRefineDesign(before, before.replace("Before", "After"), "Change heading text"));
assert.throws(() => assertRefineDesign(before, before.replace("red", "blue"), "Add a contact form"));
assert.throws(() => assertRefineDesign(before, before.replace("<main>Before</main>", ""), "Add a form"));
assert.doesNotThrow(() => assertRefineDesign(before, "<html>Redesigned</html>", "Redesign the entire app"));
assert.equal(requestsRedesign("Do not redesign the app"), false);
assert.equal(requestsRedesign("Please redesign the app"), true);
assert.equal(normalizeDomain("WWW.Example.com."), "www.example.com");
for (const domain of ["https://example.com", "example.com/path", "127.0.0.1", "localhost", "example.com:443", "evil.github.io"]) assert.throws(() => normalizeDomain(domain));
assert.equal(domainRecords("example.co.uk", "Owner", "proof").filter(x => x.type === "A").length, PAGES_IPV4.length);
const asset = { id: "abc", name: "Logo", dataUrl: "data:image/webp;base64,AAAA", role: "content" as const };
assert.ok(!assetContext([asset]).includes("AAAA"));
assert.equal(restoreProjectImages('<img src="obs-asset://abc">', [asset]), '<img src="data:image/webp;base64,AAAA">');
assert.throws(() => restoreProjectImages('<img src="obs-asset://unknown">', [asset]));
console.log("Build reliability checks passed.");
