import assert from "node:assert/strict";
import { buildFullAppFiles } from "../full-app-scaffold.ts";
import { APP_ADDON_IDS, validateAppAddons } from "../full-app-build.ts";
import { reconcileFullAppFiles } from "../full-app-edits.ts";

const html = "<!doctype html><html><body><h1>App</h1></body></html>";
const files = buildFullAppFiles(html, "Acme", ["lucide-react", "zod"]);
const pkg = JSON.parse(files["package.json"]);
assert.equal(pkg.dependencies["lucide-react"], "0.575.0");
assert.equal(pkg.dependencies["zod"], "4.4.3");
assert.equal(pkg.dependencies["react"], "19.2.0");
assert.ok(!pkg.dependencies["random-package"]);
assert.ok(files["vite.config.ts"].includes("GITHUB_PAGES_BASE"));
assert.ok(files["README.md"].includes("GitHub Actions"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("npm run build"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("playwright install --with-deps chromium"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("npm run qa:e2e"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("obsidian-build-report.json"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("workflow_dispatch:"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("contents: read"));
assert.ok(!files[".github/workflows/obsidian-build.yml"].includes("pages: write"));
assert.ok(files[".github/workflows/obsidian-publish.yml"].includes("actions/deploy-pages@v4"));
assert.ok(files[".github/workflows/obsidian-publish.yml"].includes("pages: write"));
assert.ok(files[".github/workflows/obsidian-publish.yml"].includes("id-token: write"));
assert.ok(files[".github/workflows/obsidian-ship.yml"].includes("Obsidian Ship"));
assert.ok(files[".github/workflows/obsidian-ship.yml"].includes("npm run qa:e2e"));
assert.ok(files[".github/workflows/obsidian-ship.yml"].includes("Build Pages artifact after QA passes"));
assert.ok(files[".github/workflows/obsidian-ship.yml"].includes("Verify deployed production URL"));
assert.ok(files[".github/workflows/obsidian-ship.yml"].includes("obsidian-live-qa"));
assert.ok(files["scripts/obsidian-live-check.mjs"].includes("OBSIDIAN_LIVE_QA: PASS"));
assert.ok(files["scripts/obsidian-live-check.mjs"].includes("horizontal overflow"));
assert.ok(files[".github/workflows/obsidian-health.yml"].includes("schedule:"));
assert.ok(files[".github/workflows/obsidian-health.yml"].includes("17 */6 * * *"));
assert.ok(files[".github/workflows/obsidian-health.yml"].includes("obsidian-live-check.mjs"));
assert.ok(files[".github/workflows/obsidian-build.yml"].includes("VITE_STRIPE_PUBLISHABLE_KEY"));
assert.ok(files[".github/workflows/obsidian-ship.yml"].includes("VITE_STRIPE_PUBLISHABLE_KEY"));
assert.ok(files["playwright.config.ts"].includes("desktop-chromium"));
assert.ok(files["playwright.config.ts"].includes("mobile-chromium"));
assert.ok(files["tests/obsidian.smoke.spec.ts"].includes("horizontal overflow"));
assert.equal(JSON.parse(files["package.json"]).devDependencies["@playwright/test"], "1.56.1");
assert.equal(JSON.parse(files["package.json"]).scripts["qa:e2e"], "playwright test");
assert.ok(files[".github/workflows/obsidian-publish.yml"].includes("${{ github.event.repository.name }}"));
assert.ok(files[".github/workflows/obsidian-publish.yml"].includes("vars.VITE_SUPABASE_PUBLISHABLE_KEY"));
assert.ok(files[".gitignore"].includes(".env.*"));
assert.deepEqual(validateAppAddons([]), []);
assert.equal(validateAppAddons(APP_ADDON_IDS).length, 4);
assert.throws(() => validateAppAddons(["postinstall-malice"]));
assert.throws(() => validateAppAddons("lucide-react"));
assert.throws(() => validateAppAddons([...APP_ADDON_IDS, "date-fns"]));
const existing = { ...files, "src/App.tsx": "export default function App(){ return <h1>Custom</h1> }" };
const upgraded = reconcileFullAppFiles(html, "Acme", existing, ["zod"]);
assert.ok(upgraded["src/App.tsx"].includes("Custom"));
assert.equal(JSON.parse(upgraded["package.json"]).dependencies["zod"], "4.4.3");
assert.equal(JSON.parse(upgraded["package.json"]).dependencies["lucide-react"], undefined);
assert.equal(upgraded[".github/workflows/obsidian-publish.yml"], files[".github/workflows/obsidian-publish.yml"]);
assert.equal(upgraded[".github/workflows/obsidian-ship.yml"], files[".github/workflows/obsidian-ship.yml"]);
assert.equal(upgraded["playwright.config.ts"], files["playwright.config.ts"]);
assert.throws(() => reconcileFullAppFiles(html, "Acme", { ...existing, ".github/workflows/evil.yml": "bad" }));
assert.throws(() => reconcileFullAppFiles(html, "Acme", { ...existing, ".env.production": "SERVICE_ROLE_KEY=secret" }));
console.log("Managed Full App build and deployment scaffolding tests passed");
